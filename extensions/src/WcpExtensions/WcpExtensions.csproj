<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WCP Extensions - Revit add-in. Built once per Revit version:
      dotnet build -c Release -p:RevitVersion=2024   (.NET Framework 4.8)
      dotnet build -c Release -p:RevitVersion=2025   (.NET 8)
      dotnet build -c Release -p:RevitVersion=2026   (.NET 8)
      dotnet build -c Release -p:RevitVersion=2027   (.NET 10)
  -->

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2024'">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2025'">2025.0.2</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2026'">2026.0.4</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2027'">2027.0.0</RevitApiVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WcpExtensions</AssemblyName>
    <RootNamespace>WcpExtensions</RootNamespace>
    <OutputPath>bin\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);MSB3277;CA1416;NETSDK1138</NoWarn>
    <!-- obj\<year>\ of the other Revit builds must not be compiled in. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The toolkit template (..\..\template) is embedded; "Create toolkit" writes it out. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\template\**\*" Exclude="..\..\template\**\bin\**;..\..\template\**\obj\**"
                      LogicalName="template/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
