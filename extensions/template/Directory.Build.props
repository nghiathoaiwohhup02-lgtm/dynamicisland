<Project>
  <!--
    WCP Extensions kit - do not edit.
    One project, built once per Revit version:
      Revit 2024 -> .NET Framework 4.8,  Revit 2025/2026 -> .NET 8,  Revit 2027 -> .NET 10.
    Output goes to bin\<year>\. Build with build.ps1 (it gives every build a unique name,
    which is what lets Revit load the new version with Reload, without a restart).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(RevitVersion)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2024'">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2025'">2025.0.2</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2026'">2026.0.4</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2027'">2027.0.0</RevitApiVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)_b$(BuildStamp)</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <!-- bin\ and obj\ are build output, not source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);MSB3277;CA1416;NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit itself provides these at run time, so they are never copied to bin\. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
