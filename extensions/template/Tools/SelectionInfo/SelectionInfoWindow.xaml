<Window x:Class="__TOOLKIT_ID__.SelectionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selection Info" Width="420" Height="460" MinWidth="340" MinHeight="300"
        Background="#F2F2F7" FontFamily="Segoe UI" FontSize="13" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="BorderBrush" Value="#0A84FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,12">
            <TextBlock Text="Elements by category" FontSize="18" FontWeight="SemiBold" Foreground="#1C1C1E" />
            <TextBlock x:Name="ScopeText" Foreground="#6E6E73" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="4">
            <ListView x:Name="Rows" BorderThickness="0" Background="Transparent"
                      SelectionMode="Single" MouseDoubleClick="List_MouseDoubleClick"
                      SelectionChanged="List_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Category" Width="240" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="Count" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" MinWidth="56" TextAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="TotalText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Button}" IsCancel="True" />
            <Button x:Name="SelectButton" DockPanel.Dock="Right" Content="Select" Style="{StaticResource Primary}"
                    IsEnabled="False" Click="Select_Click" />
        </DockPanel>
    </Grid>
</Window>
