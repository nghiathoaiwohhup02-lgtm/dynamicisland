<Window x:Class="DynamicIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="480" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Cửa sổ trong suốt hoàn toàn để chuột đi xuyên qua; chỉ khối đen "Island" nhận chuột.
        Đảo dạng tai thỏ (iPhone 13): dính sát mép trên, bo hai góc dưới, hai "vành" lõm nối vào mép màn hình.
    -->
    <Canvas>
        <Grid x:Name="Island" Canvas.Left="0" Canvas.Top="0" Width="212" Height="30"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              MouseLeftButtonDown="Island_MouseLeftButtonDown"
              PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
              AllowDrop="True" DragEnter="Island_DragEnter" DragLeave="Island_DragLeave" Drop="Island_Drop"
              KeyDown="Island_KeyDown">

            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource IslandBrush}"
                  Data="M0,0 L6,0 L6,6 A6,6 0 0 0 0,0 Z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{StaticResource IslandBrush}"
                  Data="M6,0 L0,0 L0,6 A6,6 0 0 1 6,0 Z" />

            <Border x:Name="Body" Margin="6,0" CornerRadius="0,0,10,10" Background="{StaticResource IslandBrush}"
                    Cursor="Hand">
                <Grid>
                    <!-- Thu gọn: giờ bên trái, hoạt động đang diễn ra bên phải. -->
                    <Grid x:Name="CompactLayer" Margin="16,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ClockText}" Style="{StaticResource Text}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ContentControl Grid.Column="1" Margin="12,0,0,0" Focusable="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Content="{Binding LiveModule.CompactView}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource DimText}" Text="{Binding DateText}"
                                   Visibility="{Binding LiveModule, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Báo tin ngắn. -->
                    <Grid x:Name="PeekLayer" Margin="14,0" Opacity="0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Peek.Glyph}" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Peek.Title}" Style="{StaticResource Text}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Peek.Message}" Style="{StaticResource DimText}" />
                        </StackPanel>
                    </Grid>

                    <!-- Mở rộng: thanh tab + nội dung module đang chọn. -->
                    <Grid x:Name="ExpandedLayer" Margin="12,6,12,8" Opacity="0" Visibility="Collapsed" Cursor="Arrow">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--
                            Tab là nút bấm chứ không dùng ListBox: ListBoxItem chỉ chọn được khi lấy được focus bàn phím,
                            mà đảo cố ý không lấy focus (để Revit giữ focus), nên ListBox không đổi tab được.
                        -->
                        <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TabButton}" Content="{Binding Glyph}" ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.SelectedModule" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl Grid.Row="1" Margin="0,4,0,0" Focusable="False"
                                        Content="{Binding SelectedModule.ExpandedView}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Canvas>
</Window>
