<Window x:Class="DynamicIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="640" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Cửa sổ trong suốt hoàn toàn để chuột đi xuyên qua; chỉ khối đen "Island" nhận chuột. -->
    <Grid>
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Width="190" Height="34" CornerRadius="17"
                Background="{StaticResource IslandBrush}"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">

            <Grid>
                <!-- Thu gọn: giờ bên trái, hoạt động đang diễn ra bên phải. -->
                <Grid x:Name="CompactLayer" Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource Text}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ContentControl Grid.Column="1" Margin="12,0,0,0" Focusable="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="{Binding LiveModule.CompactView}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource DimText}" Text="{Binding DateText}"
                               Visibility="{Binding LiveModule, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </Grid>

                <!-- Báo tin ngắn. -->
                <Grid x:Name="PeekLayer" Margin="18,0" Opacity="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Peek.Glyph}" Style="{StaticResource Glyph}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Peek.Title}" Style="{StaticResource Text}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Peek.Message}" Style="{StaticResource DimText}" />
                    </StackPanel>
                </Grid>

                <!-- Mở rộng: thanh tab + nội dung module đang chọn. -->
                <Grid x:Name="ExpandedLayer" Margin="18,12,18,16" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" Style="{StaticResource DimText}"
                                   VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource TabList}" ItemsSource="{Binding Modules}"
                                 SelectedItem="{Binding SelectedModule}" />
                    </DockPanel>
                    <ContentControl Grid.Row="1" Margin="0,12,0,0" Focusable="False"
                                    Content="{Binding SelectedModule.ExpandedView}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
