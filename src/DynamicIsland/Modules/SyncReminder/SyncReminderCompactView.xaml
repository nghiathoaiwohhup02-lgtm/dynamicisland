<UserControl x:Class="DynamicIsland.Modules.SyncReminder.SyncReminderCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource RedBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding CompactText}" Style="{StaticResource Text}" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
