<UserControl x:Class="DynamicIsland.Modules.SyncReminder.SyncReminderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceBrush}" Margin="0,0,12,0">
            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" FontSize="11" Margin="0,2,0,8" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRevitRunning, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource PillButton}" Content="Đã sync" Command="{Binding ConfirmSyncedCommand}"
                        Background="{StaticResource GreenBrush}" Foreground="#FF000000" FontWeight="SemiBold" Margin="0,0,6,0"
                        ToolTip="Đảo cũng tự nhận biết khi anh bấm Sync trong Revit" />
                <Button Style="{StaticResource PillButton}" Content="Nhắc lại sau 5'" Command="{Binding SnoozeCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
