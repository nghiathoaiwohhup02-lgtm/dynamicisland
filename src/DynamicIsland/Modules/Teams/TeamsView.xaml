<UserControl x:Class="DynamicIsland.Modules.Teams.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsInMeeting}">
            <Button Style="{StaticResource BigIconButton}" Content="&#xE720;" Background="{Binding MicBackground}" Foreground="{StaticResource TextBrush}" Command="{Binding ToggleMuteCommand}"
                    ToolTip="Bật / tắt mic" Margin="0,0,8,0" />
            <Button Style="{StaticResource BigIconButton}" Content="&#xE714;" Background="{Binding CameraBackground}" Foreground="{StaticResource TextBrush}" Command="{Binding ToggleVideoCommand}"
                    ToolTip="Bật / tắt camera" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="Giơ tay" Command="{Binding ToggleHandCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="Rời họp" Command="{Binding LeaveCommand}"
                    Background="{StaticResource RedBrush}" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</UserControl>
