<UserControl x:Class="DynamicIsland.Modules.Teams.TeamsCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bấm thẳng ở dạng thu gọn, không cần mở đảo. -->
    <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Style="{StaticResource IconButton}" Content="&#xE720;" Background="{Binding MicBackground}" Command="{Binding ToggleMuteCommand}"
                Width="24" Height="24" FontSize="11" Margin="0,0,4,0" ToolTip="Bật / tắt mic" />
        <Button Style="{StaticResource IconButton}" Content="&#xE714;" Background="{Binding CameraBackground}" Command="{Binding ToggleVideoCommand}"
                Width="24" Height="24" FontSize="11" ToolTip="Bật / tắt camera" />
    </StackPanel>
</UserControl>
