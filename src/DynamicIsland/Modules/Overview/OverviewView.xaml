<UserControl x:Class="DynamicIsland.Modules.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Time}" Style="{StaticResource Text}" FontSize="54" FontWeight="Light" />
            <TextBlock Text="{Binding Date}" Style="{StaticResource DimText}" FontSize="13" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
              ToolTip="Bấm để cập nhật. Đổi thành phố trong file cấu hình (khay hệ thống)">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding RefreshCommand}" />
            </Grid.InputBindings>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding WeatherIcon}" Style="{StaticResource Text}" FontFamily="Segoe UI Emoji"
                               FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Temperature}" Style="{StaticResource Text}" FontSize="34" FontWeight="Light" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Condition}" Style="{StaticResource Text}" />
                        <TextBlock Text="{Binding City}" Style="{StaticResource DimText}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Details}" Style="{StaticResource DimText}" Margin="0,4,0,8" FontSize="11" />
                <ItemsControl ItemsSource="{Binding Forecast}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="0,0,6,0" Padding="6,4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Day}" Style="{StaticResource DimText}" HorizontalAlignment="Center" FontSize="11" />
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Text}" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Range}" Style="{StaticResource Text}" HorizontalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
