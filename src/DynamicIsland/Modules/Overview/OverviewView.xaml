<UserControl x:Class="DynamicIsland.Modules.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="2,0,14,0">
            <TextBlock Text="{Binding Time}" Style="{StaticResource Text}" FontSize="34" FontWeight="Light" />
            <TextBlock Text="{Binding Date}" Style="{StaticResource DimText}" FontSize="11" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
              ToolTip="{Binding Details}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding RefreshCommand}" />
            </Grid.InputBindings>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding WeatherIcon}" Style="{StaticResource Text}" FontFamily="Segoe UI Emoji"
                               FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Temperature}" Style="{StaticResource Text}" FontSize="22" FontWeight="Light"
                               VerticalAlignment="Center" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Condition}" Style="{StaticResource Text}" FontSize="11" />
                        <TextBlock Text="{Binding City}" Style="{StaticResource DimText}" FontSize="10" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Forecast}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Margin="0,0,4,0" Padding="4,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Day}" Style="{StaticResource DimText}" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Text}" FontFamily="Segoe UI Emoji" FontSize="10"
                                               Margin="3,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Range}" Style="{StaticResource Text}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
