<UserControl x:Class="DynamicIsland.Modules.Outlook.OutlookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cuộc họp kế tiếp -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="8,6" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="{Binding MeetingCountdown}" Style="{StaticResource Text}" FontSize="10" Foreground="{StaticResource OrangeBrush}" />
                <TextBlock Text="{Binding MeetingTitle}" Style="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" ToolTip="{Binding MeetingTitle}" />
                <TextBlock Text="{Binding MeetingTime}" Style="{StaticResource DimText}" FontSize="10" Margin="0,1,0,5" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding NextMeeting, Converter={StaticResource NullToVisibility}}">
                    <Button Style="{StaticResource PillButton}" Content="Vào Teams" Command="{Binding JoinCommand}" Padding="9,3" FontSize="11"
                            Background="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,4,0"
                            Visibility="{Binding HasTeamsLink, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PillButton}" Content="Mở" Command="{Binding OpenMeetingCommand}" Padding="9,3" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Thư chưa đọc -->
        <StackPanel Grid.Column="1">
            <DockPanel Margin="0,0,0,3">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Width="20" Height="20" FontSize="10"
                        Command="{Binding RefreshCommand}" ToolTip="Cập nhật" />
                <TextBlock Style="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="Mở hộp thư">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenInboxCommand}" />
                    </TextBlock.InputBindings>
                    <Run Text="{Binding UnreadCount, Mode=OneWay}" /><Run Text=" thư chưa đọc" />
                </TextBlock>
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" FontSize="10" TextWrapping="Wrap"
                       Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Mails}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenMailCommand, ElementName=Root}" CommandParameter="{Binding}"
                                ClickMode="Press" Cursor="Hand" Focusable="False" ToolTip="{Binding Line}" Margin="0,0,0,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="4,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource DimText}" FontSize="10" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding Line}" Style="{StaticResource Text}" FontSize="11" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
