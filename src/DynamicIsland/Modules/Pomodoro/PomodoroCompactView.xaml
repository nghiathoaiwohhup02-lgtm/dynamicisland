<UserControl x:Class="DynamicIsland.Modules.Pomodoro.PomodoroCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource OrangeBrush}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text}" FontWeight="SemiBold" Foreground="{StaticResource OrangeBrush}"
                   VerticalAlignment="Center" />
        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Width="48" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
