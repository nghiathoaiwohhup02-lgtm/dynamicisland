<UserControl x:Class="DynamicIsland.Modules.Work.WorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:work="clr-namespace:DynamicIsland.Modules.Work"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="Root">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WorkBrush" Color="#FF64D2FF" />
        <SolidColorBrush x:Key="StarBrush" Color="#FFFFD60A" />

        <!-- Ô chữ trông như chữ thường; bấm vào là sửa được ngay. -->
        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddInput" TargetType="TextBox" BasedOn="{StaticResource PlainInput}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="24" />
        </Style>

        <!-- Nút lọc / chọn danh sách: Tag=True là đang chọn. -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Background" Value="{StaticResource WorkBrush}" />
                    <Setter Property="Foreground" Value="#FF000000" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowTool" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <DataTemplate DataType="{x:Type work:WorkGroupHeader}">
            <StackPanel Orientation="Horizontal" Margin="0,5,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DimText}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock Text="{Binding OpenCount}" Style="{StaticResource DimText}" FontSize="10" Margin="6,0,0,0" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type work:WorkItem}">
            <Grid x:Name="Row" Height="22" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Đã làm -->
                <CheckBox IsChecked="{Binding Done}" ClickMode="Press" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                          ToolTip="Đánh dấu đã làm / chưa làm">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Box" Width="13" Height="13" CornerRadius="4" BorderThickness="1.4" Background="Transparent"
                                    BorderBrush="{StaticResource TextDimBrush}">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="#FF000000"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource WorkBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WorkBrush}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>

                <!-- Quan trọng -->
                <ToggleButton Grid.Column="1" IsChecked="{Binding Important}" ClickMode="Press" Focusable="False" Cursor="Hand"
                              Margin="6,0,4,0" VerticalAlignment="Center" ToolTip="Quan trọng">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="11" Background="Transparent"
                                       Foreground="#40F5F5F7" VerticalAlignment="Center" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource StarBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Nội dung: bấm vào để sửa; việc đã làm thì gạch ngang. -->
                <TextBox x:Name="Edit" Grid.Column="2" Style="{StaticResource PlainInput}" Padding="2,0"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Text}" />
                <TextBlock x:Name="DoneText" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource DimText}" FontSize="12"
                           Margin="4,0,0,0" VerticalAlignment="Center" TextDecorations="Strikethrough" Visibility="Collapsed" Opacity="0.7" />

                <!-- Đang chờ người khác -->
                <Button Grid.Column="3" Style="{StaticResource PillButton}" Content="chờ" FontSize="10" Padding="6,0"
                        Background="Transparent" Foreground="{StaticResource OrangeBrush}" BorderBrush="{StaticResource OrangeBrush}"
                        Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Đang chờ người khác. Bấm để bỏ nhãn."
                        Command="{Binding DataContext.ToggleWaitingCommand, RelativeSource={RelativeSource AncestorType=work:WorkView}}" CommandParameter="{Binding}"
                        Visibility="{Binding Waiting, Converter={StaticResource BoolToVisibility}}" />

                <!-- Công cụ hiện khi rê chuột vào dòng -->
                <StackPanel x:Name="Tools" Grid.Column="4" Orientation="Horizontal" Visibility="Collapsed" Margin="2,0,0,0">
                    <Button Style="{StaticResource RowTool}" Content="&#xE823;" ToolTip="Đánh dấu đang chờ người khác"
                            Command="{Binding DataContext.ToggleWaitingCommand, RelativeSource={RelativeSource AncestorType=work:WorkView}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowTool}" Content="&#xE8AB;" ToolTip="Chuyển sang nhóm kế tiếp"
                            Command="{Binding DataContext.MoveGroupCommand, RelativeSource={RelativeSource AncestorType=work:WorkView}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowTool}" Content="&#xE74D;" ToolTip="Xóa việc"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=work:WorkView}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Edit" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DoneText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tools" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Danh sách + bộ lọc -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FilterChip}" Content="Chưa làm" Tag="{Binding FilterOpen}"
                        Command="{Binding SetFilterCommand}" CommandParameter="open" />
                <Button Style="{StaticResource FilterChip}" Content="Quan trọng" Tag="{Binding FilterImportant}"
                        Command="{Binding SetFilterCommand}" CommandParameter="important" />
                <Button Style="{StaticResource FilterChip}" Content="Tất cả" Tag="{Binding FilterAll}"
                        Command="{Binding SetFilterCommand}" CommandParameter="all" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" Content="{Binding Label}" Tag="{Binding IsSelected}"
                                    Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=work:WorkView}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Việc theo nhóm -->
        <ScrollViewer Grid.Row="1" Margin="0,4,0,4" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Không có việc nào ở đây" Style="{StaticResource DimText}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource PillButton}" Content="Xóa danh sách này" FontSize="11" Padding="10,3" Margin="0,8,0,0"
                    Command="{Binding DeleteListCommand}"
                    Visibility="{Binding CanDeleteList, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Thêm việc: nút bên trái đổi chỗ thêm (nhóm, nhóm mới, danh sách mới). -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="Thêm vào" Style="{StaticResource DimText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Style="{StaticResource PillButton}" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                    Command="{Binding CycleTargetCommand}" ToolTip="Bấm để đổi nhóm / tạo nhóm mới / danh sách mới">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TargetLabel}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBox Style="{StaticResource AddInput}" Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Gõ rồi nhấn Enter">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
