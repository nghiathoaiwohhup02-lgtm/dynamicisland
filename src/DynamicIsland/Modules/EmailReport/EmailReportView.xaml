<UserControl x:Class="DynamicIsland.Modules.EmailReport.EmailReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" FontSize="11" Margin="0,2,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PillButton}" Content="Mở báo cáo hôm nay" Command="{Binding OpenTodayCommand}"
                        Background="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,6,0"
                        Visibility="{Binding TodayPath, Converter={StaticResource NullToVisibility}}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding OpenFolderCommand}" ToolTip="Mở thư mục báo cáo" />
            </StackPanel>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Recent}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource PillButton}" Content="{Binding Label}" Margin="0,0,0,4" Padding="10,3" FontSize="11"
                            Command="{Binding DataContext.OpenFileCommand, ElementName=Root}" CommandParameter="{Binding}"
                            ToolTip="{Binding Path}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
