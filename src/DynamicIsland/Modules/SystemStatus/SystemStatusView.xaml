<UserControl x:Class="DynamicIsland.Modules.SystemStatus.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <!-- Pin -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource SurfaceBrush}">
                <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource Glyph}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="Pin" Style="{StaticResource Text}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BatteryText}" Style="{StaticResource DimText}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Text}" FontSize="22" FontWeight="Light" VerticalAlignment="Center"
                       Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                <Run Text="{Binding BatteryPercent, Mode=OneWay}" /><Run Text="%" />
            </TextBlock>
        </Grid>

        <!-- Âm lượng -->
        <Grid IsEnabled="{Binding HasAudio}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}"
                    ToolTip="Bật / tắt tiếng" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource DimText}" Margin="0,0,0,2" />
                <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}" SmallChange="2" LargeChange="10" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Text}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding Volume, StringFormat={}{0:0}%}" />
        </Grid>
    </StackPanel>
</UserControl>
