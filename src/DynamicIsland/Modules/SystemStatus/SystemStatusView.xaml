<UserControl x:Class="DynamicIsland.Modules.SystemStatus.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <!-- Pin -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource DimText}" Text="{Binding BatteryText}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Text}" FontSize="14" VerticalAlignment="Center"
                       Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                <Run Text="{Binding BatteryPercent, Mode=OneWay}" /><Run Text="%" />
            </TextBlock>
        </Grid>

        <!-- Âm lượng -->
        <Grid IsEnabled="{Binding HasAudio}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}"
                    ToolTip="Bật / tắt tiếng" />
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource DimText}" FontSize="10" />
                <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}" SmallChange="2" LargeChange="10" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding Volume, StringFormat={}{0:0}%}" />
        </Grid>
    </StackPanel>
</UserControl>
