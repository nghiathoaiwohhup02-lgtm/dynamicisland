<UserControl x:Class="DynamicIsland.Modules.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <TextBlock Text="Chưa có gì. Chữ anh copy (Ctrl+C) sẽ hiện ở đây, bấm vào để chép lại."
                   Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Center" Margin="20,0" x:Name="Hint" />
        <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Content="&#xE74D;"
                    Width="22" Height="22" FontSize="10" Margin="6,0,0,0" ToolTip="Xóa hết lịch sử" Command="{Binding ClearAllCommand}" />
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.CopyCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    ClickMode="Press" Focusable="False" Cursor="Hand" Margin="0,0,0,2" ToolTip="{Binding Text}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="6,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource DimText}" FontSize="10" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Text}" FontSize="11" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
