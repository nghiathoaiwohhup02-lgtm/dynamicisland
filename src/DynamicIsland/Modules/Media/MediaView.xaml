<UserControl x:Class="DynamicIsland.Modules.Media.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="60" Height="60" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}"
                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Artist}" Style="{StaticResource DimText}" FontSize="11" Margin="0,1,0,0" />
            <TextBlock Text="{Binding Source}" Style="{StaticResource DimText}" FontSize="10" Margin="0,1,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasSession}">
            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Bài trước" />
            <Button Style="{StaticResource BigIconButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}"
                    Margin="6,0" ToolTip="Phát / tạm dừng" />
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Bài tiếp" />
        </StackPanel>
    </Grid>
</UserControl>
