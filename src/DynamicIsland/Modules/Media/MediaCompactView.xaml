<UserControl x:Class="DynamicIsland.Modules.Media.MediaCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:DynamicIsland.Modules.Media">
    <!-- Chỉ có sóng nhạc: không hiện tên bài, ca sĩ hay ảnh bìa. -->
    <media:EqualizerBars Height="14" BarCount="4" BarWidth="3" VerticalAlignment="Center"
                         BarBrush="{StaticResource AccentBrush}" IsActive="{Binding IsPlaying}" />
</UserControl>
