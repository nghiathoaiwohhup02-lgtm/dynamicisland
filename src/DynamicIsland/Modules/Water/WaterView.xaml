<UserControl x:Class="DynamicIsland.Modules.Water.WaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WaterBrush" Color="#FF64D2FF" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Hôm nay + điểm danh: nút nằm cùng hàng với số lần để bảng không bị cao quá. -->
        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillButton}" Command="{Binding DrinkCommand}" Padding="10,3"
                            Background="{StaticResource WaterBrush}" Foreground="#FF000000" FontWeight="SemiBold" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Đã uống" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" Width="24" Height="24" FontSize="10"
                            ToolTip="Bỏ lần điểm danh gần nhất hôm nay" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource Text}" FontSize="20" FontWeight="Light" />
                    <TextBlock Text="lần hôm nay" Style="{StaticResource DimText}" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
            <ProgressBar Style="{StaticResource ThinProgress}" Foreground="{StaticResource WaterBrush}"
                         Value="{Binding TodayProgress, Mode=OneWay}" Margin="0,6,0,6" />
            <TextBlock Text="{Binding NextText}" Style="{StaticResource DimText}" FontSize="10" ToolTip="{Binding StreakText}" />
            <TextBlock Text="{Binding StreakText}" Style="{StaticResource DimText}" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 7 ngày gần nhất -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Week}" VerticalAlignment="Center" ToolTip="{Binding StreakText}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="22" ToolTip="{Binding Count}">
                        <TextBlock Text="{Binding Count}" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" />
                        <Grid Height="36">
                            <Border x:Name="Bar" Width="10" Height="{Binding BarHeight}" CornerRadius="3" VerticalAlignment="Bottom"
                                    Background="{StaticResource SurfaceHoverBrush}" />
                        </Grid>
                        <TextBlock x:Name="Day" Text="{Binding Label}" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding MetGoal}" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource WaterBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Day" Property="Foreground" Value="{StaticResource TextBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
