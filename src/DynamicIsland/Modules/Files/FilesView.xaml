<UserControl x:Class="DynamicIsland.Modules.Files.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel>
        <!-- OneDrive -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,0,6"
                Cursor="Hand" ToolTip="Mở OneDrive">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenOneDriveCommand}" />
            </Border.InputBindings>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource OrangeBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding OneDriveText}" Style="{StaticResource Text}" FontSize="11" />
            </StackPanel>
        </Border>

        <!-- Khay file -->
        <Grid>
            <TextBlock Text="Kéo file vào đảo để giữ tạm, kéo ra để thả vào nơi khác. Bấm đúp để mở."
                       Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="20,0" x:Name="Hint" />
            <ListBox x:Name="Tray" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     PreviewMouseLeftButtonDown="Tray_PreviewMouseLeftButtonDown" PreviewMouseMove="Tray_PreviewMouseMove"
                     MouseDoubleClick="Tray_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,0,4,4" Padding="6,3,2,3"
                                            ToolTip="{Binding Path}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="11" MaxWidth="110" VerticalAlignment="Center" />
                                            <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="16" Height="16" FontSize="7" Margin="4,0,0,0"
                                                    Background="Transparent" ToolTip="Bỏ khỏi khay (file vẫn còn nguyên)"
                                                    Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
